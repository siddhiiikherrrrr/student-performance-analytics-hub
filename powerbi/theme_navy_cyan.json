{
  "name": "Navy Cyan SaaS",
  "dataColors": ["#22D3EE", "#38BDF8", "#3B82F6", "#34D399", "#FBBF24", "#F87171", "#A78BFA", "#64748B"],
  "background": "#0A1128",
  "foreground": "#E2E8F0",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#22D3EE",
  "center": "#3B82F6",
  "minimum": "#1E3A5F",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#E2E8F0" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#94A3B8" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#E2E8F0" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#22D3EE" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111C3A" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1E2D52" } }, "radius": 8 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E2E8F0" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "padding": [{ "top": 8, "bottom": 8, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0A1128" } }, "transparency": 0 }]
      }
    }
  }
}
